{
  "$schema": "./dreams.schema.json",
  "schemaVersion": 1,
  "application": {
    "id": "pip-dream-exe",
    "name": "PIP:// DREAM.EXE",
    "character": "Pip",
    "role": "Junior Dream Engineer"
  },
  "moods": {
    "rest": {
      "label": "I need rest",
      "icon": "☾",
      "word": "gentle",
      "line": "A quiet place where nothing needs to be solved.",
      "expression": "sleepy",
      "primaryColor": "#17111f",
      "accentColor": "#d9a6c7",
      "ambientColor": "rgba(217, 166, 199, 0.22)",
      "audio": {
        "baseFrequencyHz": 392,
        "oscillatorType": "sine",
        "noteRatios": [1, 1.25, 1.5, 1.25, 1.125],
        "volumeMultiplier": 0.72,
        "noteSpacingMs": 145
      },
      "keywords": ["sleepy", "rest", "quiet", "soft", "moon", "gentle", "cloud"],
      "subLabel": "let the day soften",
      "recipeTemplates": {
        "titles": ["The Quiet Between Stars", "A Blanket for the Moon", "The Slow-Down Garden"],
        "messages": ["{moodLine} Add {ingredientDetail}, then follow Pip's tiny lanterns to {destination}."]
      }
    },
    "courage": {
      "label": "I need courage",
      "icon": "✦",
      "word": "brave",
      "line": "A small light that reminds you that you can begin.",
      "expression": "brave",
      "primaryColor": "#21131e",
      "accentColor": "#c88c9d",
      "ambientColor": "rgba(200, 140, 157, 0.24)",
      "audio": {
        "baseFrequencyHz": 659.25,
        "oscillatorType": "triangle",
        "noteRatios": [1, 1.25, 1.5, 1.875, 1.5, 2],
        "volumeMultiplier": 0.82,
        "noteSpacingMs": 110
      },
      "keywords": ["brave", "journey", "rocket", "courage", "adventure", "begin"],
      "subLabel": "take one small step",
      "recipeTemplates": {
        "titles": ["A Pocketful of Brave", "The Little Lantern Route", "The First Step Comet"],
        "messages": ["{moodLine} Add {ingredientDetail}, then follow Pip's tiny lanterns to {destination}."]
      }
    },
    "wonder": {
      "label": "I need wonder",
      "icon": "✧",
      "word": "curious",
      "line": "A hidden door, a new sky, and one impossible little thing.",
      "expression": "curious",
      "primaryColor": "#1c1724",
      "accentColor": "#d5bd78",
      "ambientColor": "rgba(213, 189, 120, 0.24)",
      "audio": {
        "baseFrequencyHz": 523.25,
        "oscillatorType": "triangle",
        "noteRatios": [1, 1.25, 1.5, 1.875, 1.5, 2],
        "volumeMultiplier": 0.88,
        "noteSpacingMs": 105
      },
      "keywords": ["wonder", "star", "curious", "sparkle", "discovery", "adventure", "rocket"],
      "subLabel": "follow a little wonder",
      "recipeTemplates": {
        "titles": ["The Door Behind the Cloud", "A Map of Almost-Magic", "The Curious Star Parade"],
        "messages": ["{moodLine} Add {ingredientDetail}, then follow Pip's tiny lanterns to {destination}."]
      }
    }
  },
  "ingredients": [
    { "id": "moon-dust", "label": "Moon dust", "icon": "🌙", "detail": "a silver path through the quiet" },
    { "id": "cloud-pillow", "label": "Cloud pillow", "icon": "☁️", "detail": "a soft landing after a long day" },
    { "id": "warm-rain", "label": "Warm rain", "icon": "☔", "detail": "the sound of the world slowing down" },
    { "id": "star-seed", "label": "Star seed", "icon": "🌟", "detail": "one tiny possibility ready to grow" }
  ],
  "destinations": ["Moon Garden", "Cloud Harbor", "Star Library"],
  "copy": {
    "dailyDreamPrompts": [
      "What would you leave glowing for someone who feels lost?",
      "If your worries could float away, what shape would they take?",
      "Which tiny thing made today worth keeping?",
      "What would you tell a star that is afraid of the dark?",
      "Imagine a door that only opens when you are kind to yourself.",
      "What would your perfect little cloud carry for you?",
      "If tomorrow arrived as a gift, what would you hope was inside?"
    ],
    "componentTemplates": {
      "dreamReceipt": {
        "titleTemplate": "{title}",
        "bodyTemplate": "{message}",
        "footerTemplate": "No dream left behind · delivered by Pip",
        "requiredTokens": ["title", "message"]
      },
      "dreamShelfEmpty": {
        "title": "Your shelf is still dreaming",
        "body": "Create a little dream and save it here for another night.",
        "actionLabel": "Compose a dream"
      }
    }
  },
  "assets": {
    "retro": {
      "pixelStarSprite": "/icons.svg#star",
      "cursorSparkleSprite": "/icons.svg#sparkle",
      "pipMarkSprite": "/icons.svg#pip-mark",
      "favicon": "/favicon.svg",
      "iconSprite": "/icons.svg"
    }
  },
  "trackingMatrices": {
    "authenticationRequired": false,
    "storageScope": "browser-local",
    "remoteCollectionEnabled": false,
    "events": [
      { "id": "dream_compiled", "enabled": true, "scope": "local-only", "counterKey": "pip-dream-simulated-count" },
      { "id": "dream_saved", "enabled": true, "scope": "local-only", "counterKey": "pip-dream-simulated-count", "deduplicateBy": "dream.id" },
      { "id": "chaos_overlay_toggled", "enabled": false, "scope": "ephemeral-ui-state" }
    ],
    "modules": [
      { "id": "dream-ritual", "enabled": true, "requiresAuthentication": false, "dataScope": "configuration-only" },
      { "id": "chaos-overlay", "enabled": true, "requiresAuthentication": false, "dataScope": "ephemeral-ui-state" },
      { "id": "dream-shelf", "enabled": true, "requiresAuthentication": false, "dataScope": "browser-local" }
    ]
  },
  "limits": {
    "maxSavedDreams": 4,
    "maxTrackingEventsInMemory": 100,
    "maxRecipeTextLength": 2000
  }
}
