{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIP Dream OS Configuration",
  "type": "object",
  "required": ["schemaVersion", "application", "moods", "ingredients", "destinations", "copy", "assets", "trackingMatrices", "limits"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "application": {
      "type": "object",
      "required": ["id", "name", "character", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "character": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "moods": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "icon", "word", "line", "expression", "primaryColor", "accentColor", "ambientColor", "audio", "keywords", "subLabel", "recipeTemplates"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "word": { "type": "string", "minLength": 1 },
          "line": { "type": "string", "minLength": 1 },
          "expression": { "enum": ["sleepy", "brave", "curious"] },
          "primaryColor": { "type": "string", "minLength": 1 },
          "accentColor": { "type": "string", "minLength": 1 },
          "ambientColor": { "type": "string", "minLength": 1 },
          "audio": {
            "type": "object",
            "required": ["baseFrequencyHz", "oscillatorType", "noteRatios", "volumeMultiplier", "noteSpacingMs"],
            "properties": {
              "baseFrequencyHz": { "type": "number", "minimum": 40, "maximum": 2000 },
              "oscillatorType": { "enum": ["sine", "triangle"] },
              "noteRatios": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "number", "minimum": 0.5, "maximum": 3 } },
              "volumeMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
              "noteSpacingMs": { "type": "integer", "minimum": 40, "maximum": 300 }
            },
            "additionalProperties": false
          },
          "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "subLabel": { "type": "string" },
          "recipeTemplates": {
            "type": "object",
            "required": ["titles", "messages"],
            "properties": {
              "titles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "messages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "icon", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "icon": { "type": "string" },
          "detail": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "destinations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "copy": { "type": "object", "required": ["dailyDreamPrompts", "componentTemplates"], "properties": { "dailyDreamPrompts": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "componentTemplates": { "type": "object" } }, "additionalProperties": false },
    "assets": { "type": "object", "required": ["retro"], "properties": { "retro": { "type": "object", "additionalProperties": { "type": "string" } } }, "additionalProperties": false },
    "trackingMatrices": { "type": "object", "required": ["authenticationRequired", "storageScope", "remoteCollectionEnabled", "events", "modules"], "properties": { "authenticationRequired": { "const": false }, "storageScope": { "const": "browser-local" }, "remoteCollectionEnabled": { "const": false }, "events": { "type": "array", "items": { "type": "object", "required": ["id", "enabled", "scope"], "properties": { "id": { "type": "string" }, "enabled": { "type": "boolean" }, "scope": { "enum": ["local-only", "ephemeral-ui-state"] }, "counterKey": { "type": "string" }, "deduplicateBy": { "type": "string" } }, "additionalProperties": false } }, "modules": { "type": "array", "items": { "type": "object", "required": ["id", "enabled", "requiresAuthentication", "dataScope"], "properties": { "id": { "type": "string" }, "enabled": { "type": "boolean" }, "requiresAuthentication": { "const": false }, "dataScope": { "enum": ["configuration-only", "ephemeral-ui-state", "browser-local"] } }, "additionalProperties": false } } }, "additionalProperties": false },
    "limits": { "type": "object", "required": ["maxSavedDreams", "maxTrackingEventsInMemory", "maxRecipeTextLength"], "properties": { "maxSavedDreams": { "type": "integer", "minimum": 1, "maximum": 100 }, "maxTrackingEventsInMemory": { "type": "integer", "minimum": 1, "maximum": 1000 }, "maxRecipeTextLength": { "type": "integer", "minimum": 100, "maximum": 10000 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
